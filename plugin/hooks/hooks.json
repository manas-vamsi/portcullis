{
  "description": "Check every tool call against the portcullis policy. Deny and ask are enforced; any error blocks the call.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/policy_hook.py"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
